{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "globalDependencies": ["**/.env.*local", "**/.env", ".env.local"],
    "globalEnv": [
        "NODE_ENV",
        "PHASE",
        "PORTLESS_STATE_DIR",
        "PORTLESS_DAEMON_PORT",
        "PORTLESS_DAEMON_URL",
        "PORTLESS_PORT",
        "PORTLESS_HTTPS",
        "PORTLESS_LAN",
        "PORTLESS_TLD",
        "PORTLESS_WILDCARD",
        "PORTLESS_SYNC_HOSTS"
    ],
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
            "inputs": ["src/**", "public/**", "*.config.*", "package.json"]
        },
        "start": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["build"]
        },
        "test": {
            "dependsOn": ["^test"],
            "inputs": ["src/**", "test/**", "**/*.test.*", "**/*.spec.*", "*.config.*", "vitest.config.*", "vitest.setup.*"]
        },
        "test:watch": {
            "cache": false
        },
        "type-check": {
            "dependsOn": ["^type-check"],
            "inputs": ["src/**", "*.config.*", "package.json", "tsconfig.json", "../../tsconfig.base.json"]
        },
        "lint": {
            "inputs": ["src/**", "*.config.*", "package.json", "eslint.config.*"]
        },
        "format": {
            "cache": false
        },
        "clean": {
            "cache": false
        }
    }
}
