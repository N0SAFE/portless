{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Portless base",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "paths": {
      "@portless/core": ["./packages/core/src/index.ts"],
      "@portless/config": ["./packages/config/src/index.ts"],
      "@portless/contracts": ["./packages/contracts/src/index.ts"],
      "@portless/providers": ["./packages/providers/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
