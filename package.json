{
    "name": "portless",
    "version": "0.1.0",
    "description": "Replace port numbers with stable, named .localhost URLs — daemon-first, pluggable, Docker-Compose aware.",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.14",
    "workspaces": {
        "packages": ["apps/**", "packages/**"],
        "catalogs": {
            "build": {
                "typescript": "^5.8.3",
                "@types/node": "^25.2.3",
                "rimraf": "^6.1.3",
                "chokidar": "^5.0.0",
                "tsx": "^4.21.0"
            },
            "utils": {
                "commander": "^14.0.0",
                "picocolors": "^1.1.1",
                "prompts": "^2.4.2",
                "@types/prompts": "^2.4.2",
                "zod": "^4.0.0"
            },
            "testing": {
                "vitest": "^4.0.17",
                "@vitest/coverage-v8": "^4.0.17",
                "@vitest/ui": "^4.0.17",
                "jsdom": "^28.1.0",
                "@testing-library/jest-dom": "^6.6.3",
                "@testing-library/react": "^16.1.0",
                "@testing-library/user-event": "^14.5.2",
                "@vitejs/plugin-react": "^5.1.0"
            },
            "tanstack": {
                "@tanstack/eslint-plugin-query": "^5.81.5"
            },
            "linting": {
                "eslint": "^9.0.0",
                "@eslint/eslintrc": "^3.3.3",
                "@eslint/js": "^9.0.0",
                "@typescript-eslint/eslint-plugin": "^8.0.0",
                "@typescript-eslint/parser": "^8.0.0",
                "prettier": "^3.8.0",
                "prettier-plugin-tailwindcss": "^0.7.1"
            },
            "api:nest": {
                "@nestjs/common": "^11.1.12",
                "@nestjs/core": "^11.1.12",
                "@nestjs/platform-express": "^11.1.12",
                "@nestjs/testing": "^11.1.12",
                "reflect-metadata": "^0.2.2",
                "rxjs": "^7.8.1",
                "express": "^5.1.0",
                "@types/express": "^5.0.5",
                "nest-commander": "^3.19.1"
            },
            "next": {
                "next": "^16.1.2",
                "eslint-config-next": "^16.1.2"
            },
            "react": {
                "react": "^19.2.0",
                "react-dom": "^19.2.0",
                "@types/react": "^19.2.8",
                "@types/react-dom": "^19.2.0"
            }
        }
    },
    "scripts": {
        "dev": "bun run dev:daemon",
        "dev:daemon": "bun --cwd ./apps/daemon run dev",
        "dev:cli": "bun --cwd ./apps/cli run dev",
        "dev:dashboard": "bun --cwd ./apps/dashboard run dev",
        "cli": "bun --cwd ./apps/cli run start --",
        "daemon": "bun --cwd ./apps/daemon run start",
        "build": "turbo build",
        "build:cli": "bun --cwd ./apps/cli run build",
        "build:daemon": "bun --cwd ./apps/daemon run build",
        "start": "bun run build && bun run daemon",
        "release": "bun run scripts/release.ts",
        "test": "turbo test",
        "test:watch": "turbo test:watch",
        "type-check": "turbo type-check",
        "lint": "turbo lint",
        "format": "turbo format",
        "clean": "turbo clean && rimraf --glob 'packages/*/dist' 'apps/*/.next' '.turbo'",
        "check": "turbo run type-check lint test --continue"
    },
    "dependencies": {
        "detect-libc": "^2.1.2"
    },
    "devDependencies": {
        "@types/bun": "^1.2.0",
        "@types/node": "catalog:build",
        "concurrently": "^9.2.0",
        "prettier": "catalog:linting",
        "rimraf": "catalog:build",
        "turbo": "2.8.9",
        "typescript": "catalog:build",
        "vitest": "catalog:testing"
    },
    "engines": {
        "bun": ">=1.3.0",
        "node": ">=20.0.0"
    }
}
