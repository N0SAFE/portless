{
  "name": "@portless/core",
  "version": "0.1.0",
  "description": "Portless core: protocol types, plugin API, daemon client, proxy core, CA helpers",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "scripts": {
