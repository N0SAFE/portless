# Portless environment reference.
# Copy to `.env` and adjust. Most values are optional; defaults are compiled in.

# --- Daemon / control plane -------------------------------------------
# Where portless stores state (routes, apps, certs, config).
PORTLESS_STATE_DIR=~/.portless
# Control-plane API port (CLI + dashboard talk to the daemon here).
PORTLESS_DAEMON_PORT=4711
# Optional bearer token to protect the control plane when exposed remotely.
# PORTLESS_DAEMON_TOKEN=

# --- Proxy -------------------------------------------------------------
# Proxy port (443 with TLS, 80 with --no-tls, 7355 in compose/dockportless mode).
PORTLESS_PORT=443
# Disable HTTPS (0/1).
PORTLESS_HTTPS=1
# Custom TLD (default localhost); comma-separated for multiple.
PORTLESS_TLD=localhost
# LAN mode (0/1) — bind 0.0.0.0 + `.local` mDNS.
PORTLESS_LAN=0
# Allow unregistered subdomains to fall back to a parent route.
PORTLESS_WILDCARD=0
# Sync /etc/hosts for route hostnames (chrome/safari/firefox).
PORTLESS_SYNC_HOSTS=1

# --- default provider --------------------------------------------------
# process | docker | dockportless
PORTLESS_DEFAULT_PROVIDER=process

# --- sharing -----------------------------------------------------------
# PORTLESS_TAILSCALE=0
# PORTLESS_FUNNEL=0
# PORTLESS_NGROK=0

# --- dashboard ---------------------------------------------------------
# Where the dashboard reaches the daemon (server-side).
PORTLESS_DAEMON_URL=http://127.0.0.1:4711
# Browser-facing daemon URL for the live SSE event stream (client-side).
NEXT_PUBLIC_PORTLESS_DAEMON_URL=http://127.0.0.1:4711
NEXT_PUBLIC_PORTLESS_DAEMON_PORT=4711
